{
  "name": "ecommerce-project",
  "version": "0.1.0",
  "private": true,
  "description": "Custom single-vendor multi-product ecommerce platform (storefront + admin + API).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace @ecommerce/api",
    "dev:storefront": "npm run dev --workspace @ecommerce/storefront",
    "dev:admin": "npm run dev --workspace @ecommerce/admin",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "seed:admin": "npm run seed:admin --workspace @ecommerce/api",
    "docker:up": "powershell -ExecutionPolicy Bypass -File ./scripts/ensure-docker.ps1",
    "migrate:images": "npm run migrate:images --workspace @ecommerce/api"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "@nestjs/core@10.4.22": true
  }
}
