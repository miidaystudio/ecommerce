// Prisma schema.
// Domain models are introduced phase by phase; see phase.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  SUPER_ADMIN
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  phone         String?
  role          Role           @default(CUSTOMER)
  isBlocked     Boolean        @default(false)
  addresses     Address[]
  refreshTokens RefreshToken[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orders        Order[]
  reviews       Review[]
  couponRedemptions CouponRedemption[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("brands")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryToSubcategory")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Product {
  id              String          @id @default(uuid())
  name            String
  slug            String          @unique
  description     String
  status          ProductStatus   @default(DRAFT)
  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id])
  brandId         String?
  brand           Brand?          @relation(fields: [brandId], references: [id])
  seoTitle        String?
  seoDescription  String?
  images          ProductImage[]
  variants        ProductVariant[]
  wishlistedBy    WishlistItem[]
  reviews         Review[]
  // Denormalized from APPROVED reviews (recomputed on every moderation change)
  // so listing/sorting by rating stays a single indexed query — same rationale
  // as the displayPrice/inStock fields below.
  ratingAverage   Decimal  @db.Decimal(3, 2) @default(0)
  ratingCount     Int      @default(0)
  // Denormalized from variants (recomputed server-side on every variant write) so
  // listing/filtering/sorting stays a single indexed query instead of an aggregate join.
  displayPrice           Decimal  @db.Decimal(10, 2) @default(0)
  displayCompareAtPrice  Decimal? @db.Decimal(10, 2)
  inStock                Boolean  @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([displayPrice])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String   @unique
  name            String
  attributes      Json?
  price           Decimal  @db.Decimal(10, 2)
  compareAtPrice  Decimal? @db.Decimal(10, 2)
  stock           Int      @default(0)
  isDefault       Boolean  @default(false)
  cartItems       CartItem[]
  orderItems      OrderItem[]
  inventoryAdjustments InventoryAdjustment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model CartItem {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity      Int            @default(1)
  // Captured at add-time per arc.md's cart→order data flow; the cart API always
  // returns the *current* variant price for display/checkout — this snapshot is
  // for audit/analytics only, never trusted as the authoritative price.
  priceSnapshot Decimal        @db.Decimal(10, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, variantId])
  @@index([userId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

enum OrderStatus {
  PENDING // created, awaiting payment (Razorpay) or just placed (COD)
  CONFIRMED // payment captured (Razorpay) or accepted for fulfillment (COD) — stock deducted
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum InventoryAdjustmentReason {
  ORDER_PLACED
  ORDER_CANCELLED
  MANUAL
  RESTOCK
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING)

  // Shipping address is copied onto the order at checkout time (never a live FK)
  // so later edits/deletion of the source Address never alter a placed order.
  shippingFullName   String
  shippingPhone      String
  shippingLine1      String
  shippingLine2      String?
  shippingCity       String
  shippingState      String
  shippingPostalCode String
  shippingCountry    String

  subtotal    Decimal       @db.Decimal(10, 2)
  shippingFee Decimal       @db.Decimal(10, 2) @default(0)
  // Discount is recomputed server-side from the coupon at order time and the
  // code snapshotted here — an order's discount never changes if the coupon is
  // later edited or deleted.
  discount       Decimal  @db.Decimal(10, 2) @default(0)
  couponCode     String?
  couponId       String?
  coupon         Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  total       Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod

  items   OrderItem[]
  payment Payment?
  couponRedemption CouponRedemption?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String          @id @default(uuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Immutable snapshot at order time per arc.md — never a live reference.
  productName String
  variantName String
  sku         String
  attributes  Json?
  imageUrl    String?
  price       Decimal @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id      String        @id @default(uuid())
  orderId String        @unique
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method  PaymentMethod
  status  PaymentStatus @default(PENDING)
  amount  Decimal       @db.Decimal(10, 2)

  // Razorpay-specific — null for COD.
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  failureReason String?
  paidAt        DateTime?
  refundedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model InventoryAdjustment {
  id        String                     @id @default(uuid())
  variantId String
  variant   ProductVariant             @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change    Int
  reason    InventoryAdjustmentReason
  orderId   String?
  note      String?
  createdAt DateTime                   @default(now())

  @@index([variantId])
  @@map("inventory_adjustments")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id           String       @id @default(uuid())
  code         String       @unique
  description  String?
  discountType DiscountType
  // For PERCENTAGE this is 1-100; for FIXED it's a currency amount. Both are
  // validated > 0 at write time; the resulting discount is always clamped to
  // never exceed the cart subtotal (no negative-total orders).
  discountValue Decimal     @db.Decimal(10, 2)
  // Optional cap on a percentage discount, e.g. "20% off, up to ₹500".
  maxDiscount   Decimal?    @db.Decimal(10, 2)
  minOrderValue Decimal?    @db.Decimal(10, 2)
  // Null = unlimited. usedCount is incremented inside the order transaction.
  usageLimit      Int?
  perUserLimit    Int?
  usedCount       Int       @default(0)
  isActive        Boolean   @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?

  orders      Order[]
  redemptions CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("coupons")
}

// One row per successful redemption. Enforces per-user limits and gives the
// usedCount an auditable backing record rather than a bare counter.
model CouponRedemption {
  id       String @id @default(uuid())
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId  String @unique
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  discountAmount Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id        String       @id @default(uuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  body      String
  status    ReviewStatus @default(PENDING)
  // Set when the reviewer has a delivered order containing this product.
  isVerifiedPurchase Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One review per customer per product; editing replaces rather than stacks.
  @@unique([productId, userId])
  @@index([productId, status])
  @@map("reviews")
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
  @@map("banners")
}
