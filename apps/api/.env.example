# --- Runtime ---
NODE_ENV=development
API_PORT=4000
API_GLOBAL_PREFIX=api

# --- CORS (comma-separated; storefront + admin origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5432/ecommerce?schema=public

# --- Auth / JWT (use long random strings in production) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
REFRESH_COOKIE_NAME=refresh_token

# --- Payments (Razorpay — test/sandbox keys; client provides live keys closer to launch) ---
# Get sandbox keys from https://dashboard.razorpay.com (Test Mode) — Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_test_key_secret
# From the webhook's settings page in the Razorpay dashboard (Test Mode) after
# registering {API_URL}/payments/webhook/razorpay as the webhook URL.
RAZORPAY_WEBHOOK_SECRET=placeholder_test_webhook_secret
PAYMENTS_CURRENCY=INR

# --- Shipping (flat-fee placeholder until Phase 7 store settings) ---
FREE_SHIPPING_THRESHOLD=999
FLAT_SHIPPING_FEE=79

# --- Rate limiting -----------------------------------------------------------
# Windows are in milliseconds. The default tier covers public catalog reads;
# the auth tier covers login/register/refresh; the sensitive tier covers coupon
# preview and review writes. Leave unset to use the built-in defaults.
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=8
THROTTLE_SENSITIVE_TTL_MS=60000
THROTTLE_SENSITIVE_LIMIT=20
THROTTLE_OTP_VERIFY_TTL_MS=60000
THROTTLE_OTP_VERIFY_LIMIT=5
THROTTLE_OTP_RESEND_TTL_MS=60000
THROTTLE_OTP_RESEND_LIMIT=3

# --- Email / Notifications (Resend) ------------------------------------------
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Number of proxy hops in front of the API (1 behind Vercel/Railway/Render).
# MUST stay empty when the API is directly reachable, or clients can forge
# X-Forwarded-For and evade rate limiting entirely.
TRUST_PROXY=

# --- Admin Bootstrap / Seeding (Phase 9) -------------------------------------
# Used only when explicitly executing `npm run seed:admin` (CLI only; never run automatically)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-to-a-strong-admin-password

# --- Image Storage (Cloudinary) -----------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret


